[Desktop Entry]
Type=Application
Name=Patina
GenericName=Image Editor
Comment=Fast GPU-rendered image editor (Rust port of Pinta)
Exec=patina %F
Icon=applications-graphics
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;image/x-tga;image/openraster;
StartupWMClass=patina
